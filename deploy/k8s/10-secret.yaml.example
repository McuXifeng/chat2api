apiVersion: v1
kind: Secret
metadata:
  name: chat2api-secrets
  namespace: chat2api
type: Opaque
stringData:
  # Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  cookie-encryption-key: "REPLACE_ME_WITH_FERNET_KEY"
  # Comma-separated bearer tokens accepted by /v1/* endpoints
  authorization: "sk-REPLACE_ME"
